---
/* 一夜漬けシートの目次。カードは data/cram.ts の SHEETS から作る。 */
import Head from '../../components/Head.astro';
import { SHEETS } from '../../data/cram';
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <Head
    title="資格試験 一夜漬けシート"
    description="中小企業診断士1次試験・2次試験・統計検定2級の直前チェックシートをまとめた目次ページ"
    path="/cram/"
  />
  <style is:inline>
    :root {
      --ink: #172033;
      --muted: #5b667a;
      --line: #d9e0ea;
      --paper: #ffffff;
      --wash: #f4f7fb;
      --accent: #2856a8;
      --accent-dark: #19396f;
      --shadow: 0 12px 32px rgba(23, 32, 51, .08);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--wash);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
      font-size: 16px;
      line-height: 1.75;
    }
    a { color: var(--accent); text-underline-offset: .18em; }
    .hero {
      color: #fff;
      background: linear-gradient(135deg, #10182b, var(--accent-dark) 55%, var(--accent));
      padding: 3.5rem max(1.25rem, calc((100vw - 960px) / 2));
    }
    .eyebrow { margin: 0 0 .5rem; font-weight: 700; letter-spacing: .08em; opacity: .84; }
    h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.16; }
    .lead { max-width: 720px; margin: 1rem 0 0; opacity: .9; }
    .layout { width: min(960px, calc(100% - 2rem)); margin: 2.5rem auto 4rem; }
    h2 { margin: 0 0 1.25rem; font-size: 1.2rem; color: var(--accent-dark); letter-spacing: .04em; }
    .cards { display: grid; gap: 1.25rem; }
    .card {
      position: relative;
      display: block;
      padding: 1.5rem clamp(1.1rem, 3vw, 1.9rem) 1.5rem calc(clamp(1.1rem, 3vw, 1.9rem) + 6px);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: var(--shadow);
      color: inherit;
      text-decoration: none;
      overflow: hidden;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .card::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 6px;
      background: var(--c);
    }
    .card:hover, .card:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 18px 40px rgba(23, 32, 51, .14);
    }
    .card-exam { margin: 0; color: var(--c); font-size: .82rem; font-weight: 800; letter-spacing: .1em; }
    .card-title { margin: .35rem 0 0; font-size: 1.4rem; line-height: 1.35; }
    .card-note { margin: .6rem 0 0; color: var(--muted); font-size: .95rem; }
    .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: .9rem 0 0; padding: 0; list-style: none; }
    .tags li {
      padding: .15rem .6rem;
      border-radius: 999px;
      background: var(--c-soft);
      color: var(--c);
      font-size: .78rem;
      font-weight: 700;
    }
    .card-open { margin: 1rem 0 0; font-size: .9rem; font-weight: 700; color: var(--c); }
    .card-open::after { content: " →"; }
    .card.placeholder {
      --c: #8a94a6;
      --c-soft: #eef1f5;
      border-style: dashed;
      box-shadow: none;
      background: transparent;
      cursor: default;
    }
    .card.placeholder:hover { transform: none; box-shadow: none; }
    .card.placeholder .card-title { color: var(--muted); }
    .card.placeholder::before { background: repeating-linear-gradient(180deg, var(--c) 0 6px, transparent 6px 12px); }
    .green { --c: #176b4d; --c-soft: #e9f7f1; }
    .blue { --c: #2856a8; --c-soft: #eaf1ff; }
    .teal { --c: #087f73; --c-soft: #e5f5f2; }
    .orange { --c: #b0561d; --c-soft: #fdf1e7; }
    footer { margin-top: 2.5rem; color: var(--muted); font-size: .85rem; text-align: center; }
    footer a { color: var(--muted); }
    @media (max-width: 820px) {
      .hero { padding-top: 2.5rem; padding-bottom: 2.5rem; }
      .layout { margin-top: 1.5rem; }
    }
    @media (prefers-color-scheme: dark) {
      :root {
        color-scheme: dark;
        --ink: #e3e8ef;
        --muted: #9aa5b5;
        --line: #2a3442;
        --paper: #171d27;
        --wash: #0f141c;
        --accent: #7ea6ef;
        --accent-dark: #a9c4f5;
        --shadow: 0 12px 32px rgba(0, 0, 0, .35);
      }
      .hero { background: linear-gradient(135deg, #0b1120, #102344 55%, #1d4380); }
      .card:hover, .card:focus-visible { box-shadow: 0 18px 40px rgba(0, 0, 0, .5); }
      .card.placeholder { --c: #6b7586; --c-soft: #1f2530; }
      .green { --c: #4fc79a; --c-soft: #15302a; }
      .blue { --c: #7ea6ef; --c-soft: #18243d; }
      .teal { --c: #45c4b4; --c-soft: #11302d; }
      .orange { --c: #ec9a5c; --c-soft: #3a2414; }
    }
  </style>
</head>
<body>
  <header class="hero">
    <p class="eyebrow">CRAM SHEETS</p>
    <h1>資格試験 一夜漬けシート</h1>
    <p class="lead">試験前日から当日の朝に読み返すためのまとめシート集。定義・数値・判断ルールを、1ページの単一HTMLに詰め込んでいます。受験する試験が増えるたび、シートも随時追加していきます。</p>
  </header>

  <div class="layout">
    <h2>シート一覧</h2>
    <div class="cards">
      {SHEETS.map(sheet => (
        <a class={`card ${sheet.accent}`} href={`${sheet.page}.html`}>
          <p class="card-exam">{sheet.exam}</p>
          <p class="card-title">{sheet.title}</p>
          <p class="card-note">{sheet.note}</p>
          <ul class="tags">{sheet.tags.map(t => <li>{t}</li>)}</ul>
          <p class="card-open">シートを開く</p>
        </a>
      ))}

      <div class="card placeholder">
        <p class="card-exam">COMING SOON</p>
        <p class="card-title">次のシートは準備中</p>
        <p class="card-note">受験するたびに1枚ずつ書き足しています。次に受ける試験が決まったら、ここに追加されます。</p>
      </div>
    </div>

    <footer>
      <p><a href="/">tebukuro.me</a></p>
    </footer>
  </div>
</body>
</html>
