              <text class="fig-val" x="426" y="142.3" text-anchor="middle">49</text>
              <text class="fig-tick" x="426" y="248" text-anchor="middle">税引後利益</text>
              <rect class="fig-c1" x="466" y="81.7" width="40" height="66.7"><title>増分減価償却費の加え戻し 40万円</title></rect>
              <text class="fig-val" x="486" y="75.7" text-anchor="middle">＋40</text>
              <text class="fig-tick" x="486" y="248" text-anchor="middle">償却費</text>
              <rect class="fig-c3" x="526" y="81.7" width="40" height="25"><title>運転資本の増加 25→40万円</title></rect>
              <text class="fig-val" x="546" y="75.7" text-anchor="middle">−15</text>
              <text class="fig-tick" x="546" y="248" text-anchor="middle">運転資本</text>
              <path class="fig-c2" d="M586,230V110.7Q586,106.7 590,106.7H622Q626,106.7 626,110.7V230Z"><title>2年度 74万円</title></path>
              <text class="fig-val" x="606" y="100.7" text-anchor="middle">74</text>
