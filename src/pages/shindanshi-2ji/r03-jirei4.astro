              <tr><th scope="row">第2問(1) CF</th><td>25,600,000円</td><td><strong>31,600,000円</strong></td><td>25,600,000円</td></tr>
              <tr><th scope="row">第2問(2) NPV</th><td>＋3,868,800円・採用</td><td><strong>−6,092.92万円・不採用</strong></td><td>＋3,868,800円・採用</td></tr>
              <tr><th scope="row">第2問(3) 価格</th><td>1,932,159円</td><td><strong>1,851,853円</strong></td><td>1,932,159円</td></tr>
