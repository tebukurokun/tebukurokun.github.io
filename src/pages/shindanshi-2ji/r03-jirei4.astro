              <tr><td>30,000kg超〜40,000kg以下</td><td class="num">1,060円</td><td class="num">700円</td><td class="num"><strong>38,572kg</strong></td><td><strong>入る</strong></td></tr>
              <tr><td>40,000kg超〜50,000kg以下</td><td class="num">860円</td><td class="num">500円</td><td class="num">54,000kg</td><td>入らない（最大養殖量を超える）</td></tr>
