              <tr><th scope="row">優れている①</th><td>売上高総利益率 27.78％</td><td>棚卸資産回転率 25.79回</td><td>売上高総利益率 27.78％</td></tr>
              <tr><th scope="row">優れている②</th><td>総資本回転率 2.42回</td><td>当座比率 65.45％</td><td>棚卸資産回転率 25.79回</td></tr>
              <tr><th scope="row">課題③</th><td>売上高営業利益率 0.32％</td><td>売上高営業利益率 0.32％</td><td>売上高販管費比率 27.46％</td></tr>
              <tr><th scope="row">課題④</th><td>自己資本比率 19.85％</td><td>自己資本比率 19.85％</td><td>自己資本比率 19.85％</td></tr>
