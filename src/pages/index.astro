    <script is:inline>
      // TradingView Ticker Tape. The embed script reads its own <script>
      // element's text as JSON config. Writing that JSON inline makes editors
      // parse it as JavaScript and flag errors, so build the element here.
      (() => {
        const config = {
          symbols: [
            { proName: "INDEX:NKY", title: "日経平均（終値）" },
            { proName: "OSE:TOPIX1!", title: "TOPIX先物（20分遅延）" },
            { proName: "FOREXCOM:SPXUSD", title: "S&P 500" },
            { proName: "FOREXCOM:NSXUSD", title: "NASDAQ 100" },
            { proName: "FOREXCOM:DJI", title: "ダウ" },
            { proName: "FX_IDC:USDJPY", title: "USD/JPY" },
            { proName: "FX_IDC:EURJPY", title: "EUR/JPY" },
          ],
          showSymbolLogo: true,
          isTransparent: true,
          displayMode: "regular",
          colorTheme: "dark",
          locale: "ja",
        };
        const script = document.createElement("script");
        script.src =
          "https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js";
        script.async = true;
        script.textContent = JSON.stringify(config);
        document.querySelector(".markets").appendChild(script);
      })();

      // Cursor-tracked glow on cards
      document.querySelectorAll(".card").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
          card.style.setProperty("--my", `${e.clientY - rect.top}px`);
        });
      });
    </script>
