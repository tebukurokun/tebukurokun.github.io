---
/* トップページ。最新記事 3 件はビルド時に RSS から取る（lib/blog.ts）。取れなければビルドが止まる。
   リンクカードは data/links.ts から作る。 */
import LinkCard from '../components/root/LinkCard.astro';
import { NEIGHBORS, WORKS } from '../data/links';
import Layout from '../layouts/Root.astro';
import { getLatestPosts } from '../lib/blog';

const posts = await getLatestPosts(3);
---

<Layout title="tebukuro" description="tebukuroの個人サイト。" path="/">
  <Fragment slot="head">
    <meta name="google-adsense-account" content="ca-pub-8531181621581188">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <style is:inline>
      :root {
        --bg: #08060f;
        --bg-2: #0d0a1c;
        --fg: #e8e6f5;
        --muted: #8a86a6;
        --neon-1: #b14bff; /* purple */
        --neon-2: #00e0ff; /* cyan   */
        --neon-3: #ff3df0; /* pink   */
        --card-bg: rgba(255, 255, 255, 0.03);
        --card-border: rgba(177, 75, 255, 0.25);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        background: var(--bg);
        color: var(--fg);
      }

      body {
        font-family:
          "Space Grotesk",
          system-ui,
          -apple-system,
          "Helvetica Neue",
          sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
        position: relative;
        line-height: 1.6;
        letter-spacing: 0.01em;
      }

      /* === Background layers === */
      .bg-gradient {
        position: fixed;
        inset: 0;
        z-index: -3;
        background:
          radial-gradient(
            ellipse 60% 50% at 20% 10%,
            rgba(177, 75, 255, 0.25),
            transparent 60%
          ),
          radial-gradient(
            ellipse 50% 50% at 85% 30%,
            rgba(0, 224, 255, 0.18),
            transparent 60%
          ),
          radial-gradient(
            ellipse 60% 60% at 50% 100%,
            rgba(255, 61, 240, 0.15),
            transparent 60%
          ),
          linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
      }

      .bg-grid {
        position: fixed;
        inset: 0;
        z-index: -2;
        background-image:
          linear-gradient(rgba(177, 75, 255, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 224, 255, 0.05) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(
          ellipse 80% 70% at 50% 40%,
          #000 40%,
          transparent 100%
        );
        -webkit-mask-image: radial-gradient(
          ellipse 80% 70% at 50% 40%,
          #000 40%,
          transparent 100%
        );
      }

      .bg-noise {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.06;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
      }

      /* === Layout === */
      main {
        max-width: 980px;
        margin: 0 auto;
        padding: clamp(2.5rem, 6vh, 4rem) clamp(1.25rem, 5vw, 3rem) 6rem;
        position: relative;
      }

      /* === Top nav === */
      html {
        scroll-behavior: smooth;
      }
      .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 48px; /* 狭い画面でも .markets の margin-top と揃える */
        padding: 0.7rem clamp(1.25rem, 5vw, 3rem);
        font-family: "JetBrains Mono", monospace;
        background: rgba(8, 6, 15, 0.72);
        border-bottom: 1px solid rgba(177, 75, 255, 0.18);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .top-nav .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--fg);
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.25s ease;
      }
      .top-nav .brand:hover,
      .top-nav .brand:focus-visible {
        color: var(--neon-1);
      }
      /* favicon (/favicon.svg) と同じ絵文字。フォント差で欠けないよう
         絵文字フォントを明示する。 */
      .top-nav .brand-icon {
        font-family:
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Noto Color Emoji",
          sans-serif;
        font-size: 1.15rem;
        line-height: 1;
      }
      .top-nav ul {
        display: flex;
        align-items: center;
        gap: clamp(0.8rem, 3vw, 1.75rem);
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .top-nav ul::-webkit-scrollbar {
        display: none;
      }
      .top-nav a.nav-link {
        display: block;
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.25s ease;
      }
      .top-nav a.nav-link:hover,
      .top-nav a.nav-link:focus-visible {
        color: var(--neon-2);
      }
      /* 固定ナビの下に見出しが隠れないようにする */
      main section[id] {
        scroll-margin-top: 5rem;
      }

      /* === Hero === */
      .hero {
        margin-bottom: 6rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.75rem;
        color: var(--neon-2);
        background: rgba(0, 224, 255, 0.08);
        border: 1px solid rgba(0, 224, 255, 0.3);
        border-radius: 999px;
        margin-bottom: 1.75rem;
        animation: fadeUp 0.7s ease both;
      }
      .badge::before {
        content: "";
        width: 6px;
        height: 6px;
        background: var(--neon-2);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--neon-2);
        animation: pulse 1.6s ease-in-out infinite;
      }

      .hero h1 {
        font-size: clamp(3rem, 9vw, 6.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.04em;
        background: linear-gradient(
          135deg,
          #fff 0%,
          var(--neon-1) 50%,
          var(--neon-2) 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 1.25rem;
        animation: fadeUp 0.8s ease 0.05s both;
        position: relative;
      }
      .hero h1::after {
        content: "_";
        color: var(--neon-2);
        -webkit-text-fill-color: var(--neon-2);
        animation: blink 1s steps(1) infinite;
        margin-left: 0.1em;
      }

      .hero .tagline {
        font-family: "JetBrains Mono", monospace;
        font-size: clamp(0.95rem, 1.4vw, 1.1rem);
        color: var(--muted);
        max-width: 38ch;
        animation: fadeUp 0.8s ease 0.15s both;
      }
      .hero .tagline .prompt {
        color: var(--neon-1);
        margin-right: 0.5rem;
      }
      .hero .tagline .line {
        display: block;
      }
      .hero .tagline .line + .line {
        margin-top: 0.35rem;
      }

      .socials {
        display: flex;
        gap: 0.85rem;
        margin-top: 2rem;
        animation: fadeUp 0.8s ease 0.25s both;
      }
      .socials a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: var(--fg);
        text-decoration: none;
        font-size: 1.15rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        transition: all 0.25s ease;
      }
      .socials a:hover {
        color: var(--neon-2);
        border-color: var(--neon-2);
        box-shadow: 0 0 16px rgba(0, 224, 255, 0.4);
        transform: translateY(-2px);
      }

      /* === Section headings === */
      .section-label {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.85rem;
        color: var(--muted);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 2rem;
      }
      .section-label::before {
        content: "";
        width: 12px;
        height: 12px;
        border: 1.5px solid var(--neon-1);
        transform: rotate(45deg);
        box-shadow: 0 0 8px rgba(177, 75, 255, 0.6);
      }
      .section-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(
          90deg,
          rgba(177, 75, 255, 0.4),
          transparent
        );
      }

      /* === Stack === */
      .stack-section {
        margin-bottom: 5rem;
      }

      .stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.9rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.82rem;
        color: var(--fg);
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(177, 75, 255, 0.25);
        border-radius: 999px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.25s ease;
        opacity: 0;
        animation: fadeUp 0.5s ease forwards;
      }
      .chip::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--neon-1);
        box-shadow: 0 0 6px var(--neon-1);
      }
      .chip:hover {
        border-color: var(--neon-2);
        color: var(--neon-2);
        transform: translateY(-2px);
      }
      .chip:hover::before {
        background: var(--neon-2);
        box-shadow: 0 0 8px var(--neon-2);
      }
      .stack .chip:nth-child(1) {
        animation-delay: 0.35s;
      }
      .stack .chip:nth-child(2) {
        animation-delay: 0.4s;
      }
      .stack .chip:nth-child(3) {
        animation-delay: 0.45s;
      }
      .stack .chip:nth-child(4) {
        animation-delay: 0.5s;
      }
      .stack .chip:nth-child(5) {
        animation-delay: 0.55s;
      }
      .stack .chip:nth-child(6) {
        animation-delay: 0.6s;
      }
      .stack .chip:nth-child(7) {
        animation-delay: 0.65s;
      }

      /* === Markets === */
      /* TradingView の Ticker Tape。中身は iframe でスタイルできないので、
         リアルタイムでない銘柄は title に（終値）（20分遅延）と書いて示す。
         固定ナビの真下に全幅で置き、ページと一緒にスクロールして消える。 */
      .markets {
        position: relative;
        margin-top: 48px; /* .top-nav の min-height */
        min-height: 58px; /* iframe の高さ。読み込み前後で下がずれないように */
        border-bottom: 1px solid var(--card-border);
      }

      /* === Blog === */
      .blog-section {
        margin-bottom: 5rem;
      }
      .blog-section .chip {
        text-decoration: none;
        animation-delay: 0.7s;
      }
      .section-note {
        color: var(--muted);
        font-size: 0.92rem;
        margin-bottom: 1.25rem;
      }
      /* 最新記事。クローラーに個別記事へのリンクを渡すため、
         JS で差し込まず初期 HTML に実体の <a> を置く。 */
      .posts {
        list-style: none;
        padding: 0;
        margin: 0 0 1.5rem;
        border-top: 1px solid var(--card-border);
      }
      .posts li {
        border-bottom: 1px solid var(--card-border);
      }
      .posts a {
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        padding: 0.85rem 0.25rem;
        color: var(--fg);
        text-decoration: none;
        transition:
          color 0.25s ease,
          padding-left 0.25s ease;
      }
      .posts a:hover {
        color: var(--neon-2);
        padding-left: 0.6rem;
      }
      .post-date {
        flex: none;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.75rem;
        color: var(--muted);
      }
      .posts a:hover .post-date {
        color: var(--neon-2);
      }
      .post-title {
        font-size: 0.92rem;
        line-height: 1.5;
      }
      @media (max-width: 480px) {
        .posts a {
          flex-direction: column;
          gap: 0.2rem;
        }
      }

      /* === BBS === */
      .bbs-section {
        margin-top: 5rem;
      }
      .bbs-section .chip {
        text-decoration: none;
        animation-delay: 0.85s;
      }

      /* === Neighbors === */
      .neighbors-section {
        margin-top: 5rem;
      }

      /* === Works grid === */
      .works {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
      }
      @media (max-width: 860px) {
        .works {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      @media (max-width: 600px) {
        .works {
          grid-template-columns: repeat(2, 1fr);
          gap: 0.75rem;
        }
      }

      .card {
        position: relative;
        display: block;
        padding: 1.15rem 1.1rem 1.1rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        color: inherit;
        text-decoration: none;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        overflow: hidden;
        transition:
          transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
          border-color 0.35s ease,
          box-shadow 0.35s ease;
        isolation: isolate;
        opacity: 0;
        animation: fadeUp 0.7s ease forwards;
      }
      /* 出現の遅延は並び順で決まる（--i は LinkCard.astro が style で渡す） */
      .works .card {
        animation-delay: calc(0.35s + var(--i, 0) * 0.1s);
      }

      /* "Coming soon" placeholder card */
      .card.placeholder {
        cursor: default;
        border-style: dashed;
        border-color: rgba(177, 75, 255, 0.35);
        background: transparent;
      }
      .card.placeholder:hover {
        transform: none;
        box-shadow: none;
      }
      .card.placeholder:hover::before {
        opacity: 0;
      }
      .card.placeholder:hover::after {
        opacity: 0;
      }
      .card.placeholder:hover h3 {
        color: var(--fg);
        background: none;
        -webkit-text-fill-color: var(--fg);
      }
      .card.placeholder .card-index {
        color: var(--neon-3);
      }
      .card.placeholder .card-index .blink {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--neon-3);
        box-shadow: 0 0 8px var(--neon-3);
        margin-right: 0.45rem;
        vertical-align: middle;
        animation: pulse 1.4s ease-in-out infinite;
      }

      .card::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(
          135deg,
          var(--neon-1),
          var(--neon-2),
          var(--neon-3)
        );
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.35s ease;
        z-index: -1;
      }
      .card::after {
        content: "";
        position: absolute;
        top: var(--my, 50%);
        left: var(--mx, 50%);
        width: 280px;
        height: 280px;
        background: radial-gradient(
          circle,
          rgba(177, 75, 255, 0.18),
          transparent 70%
        );
        transform: translate(-50%, -50%);
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
        z-index: -1;
      }

      .card:hover {
        transform: translateY(-6px);
        border-color: transparent;
        box-shadow:
          0 20px 50px rgba(177, 75, 255, 0.18),
          0 0 30px rgba(0, 224, 255, 0.1);
      }
      .card:hover::before {
        opacity: 1;
      }
      .card:hover::after {
        opacity: 1;
      }

      .card .card-index {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.68rem;
        color: var(--neon-2);
        letter-spacing: 0.1em;
        margin-bottom: 0.6rem;
      }
      .card h3 {
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-bottom: 0.45rem;
        transition: color 0.3s ease;
      }
      .card h3 .card-icon {
        width: 1.15em;
        height: 1.15em;
        margin-right: 0.4em;
        vertical-align: -0.2em;
        border-radius: 4px;
      }
      .card:hover h3 {
        background: linear-gradient(135deg, var(--neon-1), var(--neon-2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .card p {
        color: var(--muted);
        font-size: 0.8rem;
        line-height: 1.55;
      }
      .card .arrow {
        position: absolute;
        top: 1.05rem;
        right: 1rem;
        font-size: 0.8rem;
        color: var(--muted);
        transition:
          transform 0.3s ease,
          color 0.3s ease;
      }
      .card:hover .arrow {
        color: var(--neon-2);
        transform: translate(4px, -4px);
      }

      /* === Footer === */
      footer {
        text-align: center;
        padding: 2.5rem 1rem 1rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.75rem;
        color: var(--muted);
        letter-spacing: 0.1em;
      }
      footer .dot {
        color: var(--neon-1);
        margin: 0 0.5rem;
      }
      footer .foot-nav {
        margin-bottom: 0.85rem;
      }
      footer .foot-nav a {
        color: var(--muted);
        text-decoration: none;
        margin: 0 0.75rem;
        transition: color 0.25s ease;
      }
      footer .foot-nav a:hover {
        color: var(--neon-2);
      }

      /* === Animations === */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 1;
        }
        50% {
          transform: scale(1.4);
          opacity: 0.6;
        }
      }

      @media (max-width: 540px) {
        main {
          padding-top: 3rem;
        }
        .hero {
          margin-bottom: 4rem;
        }
        .card {
          padding: 1rem 0.9rem 0.95rem;
        }
      }

      /* 狭い画面でナビのリンクが切れないよう、まず文字とすき間を詰める */
      @media (max-width: 540px) {
        .top-nav {
          padding-left: 1rem;
          padding-right: 1rem;
        }
        .top-nav ul {
          gap: 0.65rem;
        }
        .top-nav a.nav-link {
          font-size: 0.72rem;
          letter-spacing: 0.04em;
        }
      }

      /* さらに狭ければワードマークを畳み、手袋アイコンだけ残す */
      @media (max-width: 420px) {
        .top-nav .brand-name {
          display: none;
        }
        .top-nav .brand-icon {
          font-size: 1.35rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </Fragment>
    <div class="bg-gradient" aria-hidden="true"></div>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-noise" aria-hidden="true"></div>

    <nav class="top-nav" aria-label="メインナビゲーション">
      <a class="brand" href="/">
        <span class="brand-icon" aria-hidden="true">🧤</span>
        <span class="brand-name">tebukuro</span>
      </a>
      <ul>
        <li><a class="nav-link" href="/blog/">Blog</a></li>
        <li><a class="nav-link" href="#works">Links</a></li>
        <li><a class="nav-link" href="#bbs">BBS</a></li>
        <li><a class="nav-link" href="/privacy.html">Privacy</a></li>
        <li>
          <a
            class="nav-link"
            href="https://docs.google.com/forms/d/e/1FAIpQLSf5z7Uc6gFn1-kyc6cNLszMvAnVyzWexTWho7TrquKbQBZwyA/viewform"
            target="_blank"
            rel="noopener"
            >Contact</a
          >
        </li>
      </ul>
    </nav>

    <div class="markets tradingview-widget-container">
      <div class="tradingview-widget-container__widget"></div>
    </div>

    <main>
      <section class="hero">
        <span class="badge">HELLO, WORLD</span>
        <h1>tebukuro</h1>
        <p class="tagline">
          <span class="line"><span class="prompt">&gt;</span>born in 1995</span>
          <span class="line"
            ><span class="prompt">&gt;</span>professional software developer
            since 2018</span
          >
          <span class="line"
            ><span class="prompt">&gt;</span>based in Tokyo, Japan</span
          >
          <span class="line"
            ><span class="prompt">&gt;</span>Yomiuri Giants fan</span
          >
