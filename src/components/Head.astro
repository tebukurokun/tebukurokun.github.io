---
/* 全ページ共通の head（description から twitter:card まで）。
   og:title / og:description / og:url は title / description / canonical と同じ値を出す。
   manifest と theme-color は暗いトップページ用なので、ここではなく layouts/Root.astro が出す。 */
interface Props {
  title: string;
  description: string;
  /** サイト内のパス。ディレクトリの目次ページは `/` で終える（`/cram/`）。 */
  path: string;
  /** 省略時は、目次ページ（`/` で終わる）が website、個々のシート・事例が article */
  type?: 'website' | 'article';
  /** タブのアイコン。site はトップと同じ 🧤、study は一夜漬けシートと 2次試験解説の本のアイコン */
  icon?: 'site' | 'study';
}

const { title, description, path } = Astro.props;
const url = new URL(path, Astro.site).href;
const type = Astro.props.type ?? (path.endsWith('/') ? 'website' : 'article');
const icons = {
  site: { ico: '/favicon.ico', svg: '/favicon.svg', touch: '/apple-touch-icon.png' },
  study: { ico: '/study-favicon.ico', svg: '/link-icons/study.svg', touch: '/study-apple-touch-icon.png' },
}[Astro.props.icon ?? 'site'];
---

<meta name="description" content={description}>
<title>{title}</title>
<link rel="canonical" href={url}>
<link rel="icon" href={icons.ico} sizes="48x48">
<link rel="icon" href={icons.svg} sizes="any" type="image/svg+xml">
<link rel="apple-touch-icon" sizes="180x180" href={icons.touch}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="tebukuro">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content="https://tebukuro.me/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="tebukuro">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
